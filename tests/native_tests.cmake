file(MAKE_DIRECTORY "${WORK}")
set(fold_option)
if(FOLDING STREQUAL "off")
    set(fold_option --no-fold)
endif()
set(case_count 0)
function(native_case name body expected status error_pattern)
    set(source "${WORK}/${name}.skill")
    set(ir "${WORK}/${name}.ll")
    set(exe "${WORK}/${name}${EXE_SUFFIX}")
    file(WRITE "${source}" "mission main() -> int {\n${body}\n}\n")
    execute_process(COMMAND "${SKILLC}" "${source}" -o "${ir}" ${fold_option}
        RESULT_VARIABLE compiled ERROR_VARIABLE error TIMEOUT 10)
    if(NOT compiled EQUAL 0)
        message(FATAL_ERROR "${name}: compiler failed: ${error}")
    endif()
    if(LLVM_AS AND EXISTS "${LLVM_AS}")
        execute_process(COMMAND "${LLVM_AS}" "${ir}" -o "${WORK}/${name}.bc"
            RESULT_VARIABLE verified ERROR_VARIABLE error TIMEOUT 10)
        if(NOT verified EQUAL 0)
            message(FATAL_ERROR "${name}: LLVM IR verification failed: ${error}")
        endif()
    endif()
    execute_process(COMMAND "${CLANG}" "-O${LEVEL}" -Wno-override-module "${ir}" "${RUNTIME}" -o "${exe}"
        RESULT_VARIABLE linked OUTPUT_VARIABLE link_out ERROR_VARIABLE error TIMEOUT 30)
    if(NOT linked EQUAL 0)
        message(FATAL_ERROR "${name}: invalid IR or link failure: ${link_out}${error}")
    endif()
    execute_process(COMMAND "${exe}" RESULT_VARIABLE actual_status OUTPUT_VARIABLE actual ERROR_VARIABLE error TIMEOUT 5)
    string(REPLACE "\r\n" "\n" actual "${actual}")
    if(NOT actual_status STREQUAL "${status}" OR NOT actual STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: wanted exit ${status}, output [${expected}]; got exit ${actual_status}, output [${actual}], error [${error}]")
    endif()
    if(NOT error_pattern STREQUAL "" AND NOT error MATCHES "${error_pattern}")
        message(FATAL_ERROR "${name}: missing runtime error: ${error}")
    endif()
    if(error_pattern STREQUAL "" AND NOT error STREQUAL "")
        message(FATAL_ERROR "${name}: unexpected standard error: ${error}")
    endif()
    math(EXPR count "${case_count}+1")
    set(case_count "${count}" PARENT_SCOPE)
endfunction()

