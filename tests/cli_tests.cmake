file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${SKILLC}" --help RESULT_VARIABLE status OUTPUT_VARIABLE text)
if(NOT status EQUAL 0 OR NOT text MATCHES "Usage: skillc")
    message(FATAL_ERROR "Help command failed")
endif()
execute_process(COMMAND "${SKILLC}" --version RESULT_VARIABLE status OUTPUT_VARIABLE text)
if(NOT status EQUAL 0 OR NOT text MATCHES "0.1.0")
    message(FATAL_ERROR "Version command failed")
endif()
execute_process(COMMAND "${SKILLC}" "${ROOT}/examples/hello.skill" -o - RESULT_VARIABLE status OUTPUT_VARIABLE text)
if(NOT status EQUAL 0 OR NOT text MATCHES "define i32 @main")
    message(FATAL_ERROR "IR stdout command failed")
endif()
set(OUTPUT "${WORK}/output with spaces.ll")
file(WRITE "${OUTPUT}" "keep this output")
execute_process(COMMAND "${SKILLC}" "${ROOT}/examples/broken.skill" -o "${OUTPUT}" --serious
    RESULT_VARIABLE status ERROR_VARIABLE error)
file(READ "${OUTPUT}" preserved)
if(NOT status EQUAL 1 OR NOT error MATCHES "E010" OR error MATCHES "Skill issue:" OR NOT preserved STREQUAL "keep this output")
    message(FATAL_ERROR "Invalid source did not preserve the existing output")
endif()
execute_process(COMMAND "${SKILLC}" "${ROOT}/examples/hello.skill" -o "${OUTPUT}" --dump-tokens --dump-ast
    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE error)
if(NOT status EQUAL 0 OR NOT text MATCHES "mission main -> int" OR NOT text MATCHES "1:1 mission")
    message(FATAL_ERROR "Inspection/path with spaces command failed: ${error}")
endif()
set(COPY "${WORK}/source with spaces.skill")
configure_file("${ROOT}/examples/hello.skill" "${COPY}" COPYONLY)
file(READ "${COPY}" before)
execute_process(COMMAND "${SKILLC}" "${COPY}" -o "${COPY}" RESULT_VARIABLE status ERROR_VARIABLE error)
file(READ "${COPY}" after)
if(NOT status EQUAL 1 OR NOT before STREQUAL after)
    message(FATAL_ERROR "Compiler overwrote its source")
endif()
execute_process(COMMAND "${SKILLC}" --unknown RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 1 OR NOT error MATCHES "unknown option")
    message(FATAL_ERROR "Unknown CLI option was not rejected")
endif()
execute_process(COMMAND "${SKILLC}" "${COPY}" -o RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 1)
    message(FATAL_ERROR "Missing output argument was not rejected")
endif()
message(STATUS "CLI checks passed")
